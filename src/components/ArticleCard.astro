---
interface Props {
  href: string;
  title: string;
  description: string;
  strand: string;
  accent: string;
  date?: Date;
}
const { href, title, description, strand, accent, date } = Astro.props;
const dateLabel = date
  ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : '';
---
<article class="article-card" style={`--accent: ${accent}`}>
  <p class="card-kicker">{strand}</p>
  <h3><a href={href}>{title}</a></h3>
  <p class="card-desc">{description}</p>
  {date && <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>}
</article>

<style>
  .article-card {
    border-top: 1px solid var(--line);
    padding: 0.95rem 0 0.2rem;
  }
  .card-kicker {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h3 { font-size: 1.2rem; margin: 0.25rem 0 0.3rem; line-height: 1.25; }
  h3 a { text-decoration: none; color: var(--ink); }
  h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .card-desc { margin: 0; color: var(--ink-soft); font-size: 0.92rem; }
  time { display: block; margin-top: 0.35rem; color: var(--ink-soft); font-size: 0.8rem; }
</style>
