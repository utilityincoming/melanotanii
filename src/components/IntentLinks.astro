---
interface Item {
  href: string;
  label: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
{items.length > 0 && (
  <nav class="intents" aria-label="Related questions">
    <p>On this question</p>
    <ul>
      {items.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
)}

<style>
  .intents {
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }
  p {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
  }
  a { font-weight: 500; }
</style>
