---
import type { SourceRecord } from '../lib/source-registry';
interface Props {
  sources: SourceRecord[];
  heading?: string;
}
const { sources, heading = 'Sources' } = Astro.props;
const typeLabel: Record<SourceRecord['type'], string> = {
  paper: 'Paper',
  regulator: 'Regulator',
  company: 'Company',
  foi: 'FOI',
  other: 'Other',
};
---
{sources.length > 0 && (
  <section class="source-list">
    <h2>{heading}</h2>
    <ol>
      {sources.map((source) => (
        <li>
          <a href={source.url} rel="noopener noreferrer">{source.title}</a>
          <span>
            {typeLabel[source.type]}
            {source.year ? ` · ${source.year}` : ''}
            {source.pmid ? ` · PMID ${source.pmid}` : ''}
          </span>
        </li>
      ))}
    </ol>
    <p class="all-sources"><a href="/sources/">All sources</a></p>
  </section>
)}

<style>
  .source-list {
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 0.7rem;
    color: var(--ink-soft);
  }
  ol { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.55rem; }
  li { font-size: 0.92rem; }
  a { color: var(--ink); }
  span { display: block; color: var(--ink-soft); font-size: 0.78rem; letter-spacing: 0.04em; }
  .all-sources { margin: 0.8rem 0 0; font-size: 0.88rem; }
</style>
