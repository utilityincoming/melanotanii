---
import '../styles/editorial.css';
import Analytics from '@vercel/analytics/astro';
import { publication, tagline, organizationLd, websiteLd } from '../data/brand';
interface Props {
  title: string;
  description: string;
  /** Per-page social card; falls back to the site-wide og-image.png. */
  ogImage?: string;
  ogType?: 'website' | 'article';
}
const { title, description, ogImage: ogImageProp, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImageProp ?? '/og-image.png', Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/timeline/', label: 'Timeline' },
  { href: '/regulatory/', label: 'Regulatory' },
  { href: '/record/', label: 'Record entries' },
  { href: '/skin-record/', label: 'Skin record' },
  { href: '/articles/', label: 'Articles' },
  { href: '/faqs/', label: 'FAQs' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => path === href || path.startsWith(href);
const orgLd = organizationLd(Astro.site);
const siteLd = websiteLd(Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={publication} href="/rss.xml" />
  <!-- Brand assets -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#FBFAF7" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#191823" media="(prefers-color-scheme: dark)" />
  <!-- Open Graph / social share -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={publication} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${publication}, ${tagline}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,600;1,400&family=Archivo:wght@400;500;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(siteLd)} is:inline />
  <Analytics />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="pigment-bar" aria-hidden="true"></div>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">
        <span class="brand-name">{publication}</span>
        <span class="brand-tag">{tagline}</span>
      </a>
      <nav aria-label="Main">
        {nav.filter(({ href }) => path !== '/' || href !== '/skin-record/').map((item) => (
          <a
            href={item.href}
            class={isActive(item.href) ? 'is-active' : undefined}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >{item.label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main class="wrap" id="main-content" tabindex="-1">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <nav class="foot-record" aria-label="The Record">
        <span class="foot-kicker">The Record</span>
        <a href="/timeline/">Timeline</a>
        <a href="/regulatory/">Regulatory</a>
        <a href="/record/">Record entries</a>
        <a href="/skin-record/">Skin record</a>
        <a href="/strands/mission/">The mission</a>
        <a href="/strands/gray-market/">The gray market</a>
        <a href="/strands/spinoffs/">The spinoffs</a>
        <a href="/articles/">Articles</a>
        <a href="/sources/">Sources</a>
      </nav>
      <p>
        {publication} covers Melanotan II and the melanocortin class from the
        primary record. Nothing here is medical advice, and Melanotan II is not
        approved for any use.
      </p>
      <p>&copy; {new Date().getFullYear()} MelanotanII.com</p>
    </div>
  </footer>
</body>
</html>
