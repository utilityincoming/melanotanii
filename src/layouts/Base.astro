---
import { inject } from '@vercel/analytics';
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site).href;
inject();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="Tan Lines" href="/rss.xml" />
  <!-- Brand assets -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#FBFAF7" />
  <!-- Open Graph / social share -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Tan Lines" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Tan Lines, the unvarnished history of Melanotan II" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,600;1,400&family=Archivo:wght@400;500;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      /* Palette: eumelanin ink, porcelain paper, UV violet accent */
      --paper: #FBFAF7;
      --ink: #17130E;
      --ink-soft: #5A4F44;
      --line: #E4DFD6;
      --uv: #503296;
      /* Story strands (used on the timeline) */
      --strand-mission: #503296;  /* the photoprotection goal — same as --uv */
      --caution: #A6431F;         /* the gray market */
      --approved: #2F6A52;        /* the approved spinoffs */
      /* Pigment scale — the brand device */
      --pigment-scale: linear-gradient(90deg,
        #F3DCC8 0%, #E4B98F 20%, #C08A5A 40%,
        #8A5A34 60%, #55351D 80%, #241A12 100%);
      --font-display: 'Spectral', Georgia, serif;
      --font-body: 'Archivo', system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation: none !important; transition: none !important; }
    }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: 1.0625rem;
      line-height: 1.65;
    }
    a { color: var(--uv); text-decoration-thickness: 1px; text-underline-offset: 3px; }
    a:focus-visible, button:focus-visible {
      outline: 2px solid var(--uv);
      outline-offset: 3px;
      border-radius: 2px;
    }
    h1, h2, h3 {
      font-family: var(--font-display);
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -0.01em;
    }
    .wrap { max-width: 72rem; margin: 0 auto; padding: 0 1.25rem; }
    .prose { max-width: 42rem; }
    .prose h2 { margin-top: 2.5rem; font-size: 1.6rem; }
    .prose p { color: var(--ink); }
    /* Inline scientific figures */
    .prose figure { margin: 2.75rem 0; }
    .prose figure svg { width: 100%; height: auto; display: block; }
    .prose figcaption {
      margin-top: 0.7rem;
      font-size: 0.85rem;
      line-height: 1.5;
      color: var(--ink-soft);
      max-width: 40rem;
    }
    .eyebrow {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--uv);
    }
    /* Signature: the pigment scale bar */
    .pigment-bar { height: 6px; background: var(--pigment-scale); border: 0; }
    .site-header .wrap {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding-top: 1.1rem;
      padding-bottom: 1.1rem;
    }
    .site-header nav { display: flex; gap: 1.4rem; flex-wrap: wrap; }
    .site-header nav a { color: var(--ink); text-decoration: none; font-weight: 500; font-size: 0.95rem; }
    .site-header nav a:hover { color: var(--uv); }
    .brand {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.2rem;
      color: var(--ink);
      text-decoration: none;
    }
    .site-footer {
      margin-top: 5rem;
      border-top: 1px solid var(--line);
      color: var(--ink-soft);
      font-size: 0.875rem;
    }
    .site-footer .wrap { padding-top: 2rem; padding-bottom: 3rem; }
    .site-footer p { max-width: 46rem; }
  </style>
</head>
<body>
  <div class="pigment-bar" aria-hidden="true"></div>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">Tan Lines</a>
      <nav aria-label="Main">
        <a href="/timeline/">Timeline</a>
        <a href="/regulatory/">Regulatory</a>
        <a href="/articles/">Articles</a>
        <a href="/about/">About</a>
      </nav>
    </div>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p>
        Tan Lines publishes history and analysis of Melanotan II and the
        melanocortin drug class. Nothing on this site is medical advice, and
        this site does not sell, source, or provide usage guidance for any
        compound. Melanotan II is not approved by any regulator for any use.
      </p>
      <p>&copy; {new Date().getFullYear()} melanotanii.com</p>
    </div>
  </footer>
</body>
</html>
