---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((a) => ({ params: { id: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.pubDate.toISOString(),
  ...(article.data.updatedDate && { dateModified: article.data.updatedDate.toISOString() }),
};
---
<Base title={`${article.data.title} — Tan Lines`} description={article.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <article class="prose">
    <p class="eyebrow">{article.data.cluster.replace(/-/g, ' ')}</p>
    <h1>{article.data.title}</h1>
    <p class="meta">
      Published {article.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
    <Content />
    {article.data.seeAlso && article.data.seeAlso.length > 0 && (
      <aside class="see-also">
        <h2>The underlying science</h2>
        <p>The receptor-level reference behind this story, on our sister site melanocortin.com.</p>
        <ul>
          {article.data.seeAlso.map((s) => (
            <li>
              <a href={s.href} rel="noopener">{s.label}</a>
              {s.note && <span class="note"> - {s.note}</span>}
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>
  <style>
    article { padding-top: 3rem; }
    h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin: 0.5rem 0; }
    .meta { color: var(--ink-soft); font-size: 0.875rem; margin-bottom: 2rem; }
    .see-also {
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid color-mix(in srgb, var(--ink-soft) 30%, transparent);
    }
    .see-also h2 { font-size: 1.05rem; margin: 0 0 0.35rem; }
    .see-also > p { color: var(--ink-soft); font-size: 0.9rem; margin: 0 0 1rem; }
    .see-also ul { list-style: none; padding-left: 0; margin: 0; display: grid; gap: 0.6rem; }
    .see-also .note { color: var(--ink-soft); }
  </style>
</Base>
