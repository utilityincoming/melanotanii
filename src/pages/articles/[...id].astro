---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { clusters, clusterLabel, clusterColorVar } from '../../data/clusters';
import { publication, orgRef, recordRef, authorLd } from '../../data/brand';
import Byline from '../../components/Byline.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((a) => ({ params: { id: a.id }, props: { article: a } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

// Reading-time estimate. Strip inline SVG figures and markup first so the
// figure text and link syntax don't inflate the count; ~200 wpm, min 1.
const readingText = article.body
  .replace(/<svg[\s\S]*?<\/svg>/g, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/[#*_>`[\]()]/g, ' ');
const wordCount = (readingText.match(/\S+/g) ?? []).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// Table of contents for long reads only. Astro slugs headings automatically,
// so this is a no-JS jump-link list built from the H2s; gated to genuinely
// long pieces (enough sections AND length) so short explainers stay clean.
const sections = headings.filter((h) => h.depth === 2);
const showToc = sections.length >= 5 && wordCount >= 1200;

const clusterKey = article.data.cluster;
const label = clusterLabel(clusterKey);
const accent = clusterColorVar(clusterKey);
const threadAnchor = `/#thread-${clusterKey}`;

// Siblings in the same thread — the curated lead first, then newest — for the
// "Continue in this thread" footer (keeps readers moving through the site).
const leadId = (clusters as Record<string, { lead: string }>)[clusterKey]?.lead;
const rest = (await getCollection('articles', ({ data }) => !data.draft)).filter(
  (a) => a.data.cluster === clusterKey && a.id !== article.id
);
const lead = rest.find((a) => a.id === leadId);
const others = rest
  .filter((a) => a.id !== leadId)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const siblings = (lead ? [lead, ...others] : others).slice(0, 4);

const pageUrl = new URL(`/articles/${article.id}/`, Astro.site).href;
// Per-article social card generated at /og/<id>.png (see src/pages/og/[id].png.ts).
const ogImage = new URL(`/og/${article.id}.png`, Astro.site).href;

// Query-shaped <title> when a serpTitle exists; the H1 stays the magazine line.
const pageTitle = `${article.data.serpTitle ?? article.data.title} — ${publication}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  alternativeHeadline: article.data.serpTitle,
  description: article.data.description,
  datePublished: article.data.pubDate.toISOString(),
  ...(article.data.updatedDate && { dateModified: article.data.updatedDate.toISOString() }),
  image: ogImage,
  articleSection: label,
  inLanguage: 'en',
  isAccessibleForFree: true,
  wordCount,
  timeRequired: `PT${readingMinutes}M`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  isPartOf: recordRef(Astro.site),
  author: authorLd(Astro.site),
  reviewedBy: orgRef(Astro.site),
  publisher: {
    ...orgRef(Astro.site),
    publishingPrinciples: new URL('/standards/', Astro.site).href,
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: new URL('/articles/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: label, item: new URL(threadAnchor, Astro.site).href },
  ],
};

// FAQPage JSON-LD — only when the article carries direct-answer Q&A. This is the
// answer-engine surface (AI Overviews, "People also ask") the name-confusion and
// myth-correction files are written to capture.
const faq = article.data.faq;
const faqLd = faq && faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      isPartOf: { '@id': pageUrl },
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;
---
<Base title={pageTitle} description={article.data.description} ogImage={`/og/${article.id}.png`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />}
  <article class="prose" style={`--accent: ${accent}`}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">&rsaquo;</span>
      <a href="/articles/">Articles</a>
      <span aria-hidden="true">&rsaquo;</span>
      <a class="crumb-thread" href={threadAnchor}>{label}</a>
    </nav>
    <p class="eyebrow accent">{label}</p>
    <h1>{article.data.title}</h1>
    <p class="meta">
      By <a class="byline" href="/about/">{publication}</a>
      <span aria-hidden="true">&middot;</span>
      Published {article.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      <span aria-hidden="true">&middot;</span>
      {readingMinutes} min read
      {article.data.updatedDate && (
        <> <span aria-hidden="true">&middot;</span> Updated {article.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</>
      )}
    </p>

    {showToc && (
      <details class="toc">
        <summary>In this piece</summary>
        <ol>
          {sections.map((s) => (
            <li><a href={`#${s.slug}`}>{s.text}</a></li>
          ))}
        </ol>
      </details>
    )}

    <Content />

    <Byline section={label} />

    {faq && faq.length > 0 && (
      <section class="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Common questions</h2>
        {faq.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>
    )}

    {siblings.length > 0 && (
      <nav class="continue" aria-label={`More in ${label}`}>
        <p class="continue-head">
          <span class="continue-eyebrow accent">Continue in {label}</span>
        </p>
        <ul>
          {siblings.map((a) => (
            <li>
              <a href={`/articles/${a.id}/`}>{a.data.title}</a>
              <p>{a.data.description}</p>
            </li>
          ))}
        </ul>
        <p class="continue-all"><a href="/articles/">All articles &rarr;</a></p>
      </nav>
    )}

  </article>
  <style>
    article { padding-top: 2rem; }
    .crumbs {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.82rem;
      color: var(--ink-soft);
      margin-bottom: 1.6rem;
    }
    .crumbs a { color: var(--ink-soft); text-decoration: none; }
    .crumbs a:hover { color: var(--uv); text-decoration: underline; text-underline-offset: 3px; }
    .crumbs .crumb-thread { color: var(--accent); font-weight: 600; }
    .crumbs span { opacity: 0.6; }
    .accent { color: var(--accent); }

    /* Table of contents — long reads only; no JS, collapsed by default */
    .toc {
      margin: 0 0 2rem;
      padding: 0.6rem 1rem;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
      font-size: 0.92rem;
    }
    .toc summary {
      cursor: pointer;
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--ink);
      list-style: none;
    }
    .toc summary::-webkit-details-marker { display: none; }
    .toc summary::after { content: '+'; float: right; color: var(--accent); font-size: 1.15rem; line-height: 1; }
    .toc[open] summary::after { content: '\2013'; }
    .toc ol {
      margin: 0.8rem 0 0.2rem;
      padding-left: 1.3rem;
      display: grid;
      gap: 0.45rem;
      color: var(--ink-soft);
    }
    .toc a { color: var(--ink); text-decoration: none; }
    .toc a:hover { color: var(--uv); text-decoration: underline; text-underline-offset: 3px; }
    h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin: 0.35rem 0 0.5rem; }
    .meta { color: var(--ink-soft); font-size: 0.875rem; margin-bottom: 2rem; }
    .meta .byline { color: var(--ink); font-weight: 600; text-decoration: none; }
    .meta .byline:hover { color: var(--uv); text-decoration: underline; text-underline-offset: 3px; }

    /* Continue in this thread */
    .continue {
      margin-top: 3.5rem;
      padding-top: 1.6rem;
      border-top: 3px solid var(--accent);
    }
    .continue-head { margin: 0 0 1.1rem; }
    .continue-eyebrow {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .continue ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.1rem; }
    .continue li a { font-weight: 500; font-size: 1.08rem; text-decoration: none; }
    .continue li a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .continue li p { margin: 0.2rem 0 0; font-size: 0.9rem; color: var(--ink-soft); }
    .continue-all { margin: 1.4rem 0 0; font-size: 0.9rem; }
    .continue-all a { font-weight: 500; text-decoration: none; }
    .continue-all a:hover { text-decoration: underline; text-underline-offset: 3px; }

    /* Common questions — the answer-engine surface, rendered for humans too */
    .faq {
      margin-top: 3.25rem;
      padding-top: 1.6rem;
      border-top: 3px solid var(--accent);
    }
    .faq h2 { font-size: 1.35rem; margin: 0 0 1rem; }
    .faq-item {
      border-bottom: 1px solid var(--line);
      padding: 0.55rem 0;
    }
    .faq-item summary {
      cursor: pointer;
      font-weight: 600;
      font-family: var(--font-display);
      font-size: 1.05rem;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after {
      content: '+';
      color: var(--accent);
      font-weight: 400;
      font-size: 1.3rem;
      line-height: 1;
    }
    .faq-item[open] summary::after { content: '\2013'; }
    .faq-item summary:hover { color: var(--uv); }
    .faq-item p { margin: 0.6rem 0 0.3rem; color: var(--ink-soft); font-size: 0.96rem; }
  </style>
</Base>
