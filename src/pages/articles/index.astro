---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { clusters, clustersByStrand, strands, strandOrder } from '../../data/clusters';

const all = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const answers = all.filter((a) => a.data.kind === 'query');

function articlesFor(key: keyof typeof clusters) {
  const inCluster = all.filter((a) => a.data.cluster === key);
  const lead = inCluster.find((a) => a.id === clusters[key].lead);
  const rest = inCluster.filter((a) => a.id !== clusters[key].lead);
  return lead ? [lead, ...rest] : inCluster;
}
---
<Base
  title="All Melanotan II articles — The Record — Tan Lines"
  description="Every article in The Record: the history, science, cautionary tale, and open future of Melanotan II and the melanocortin drug class."
>
  <header class="page-head">
    <p class="eyebrow">The Record</p>
    <h1 class="page-title">All articles</h1>
    <p class="page-sub">{all.length} pieces, three strands. The short answers are first. The essays are filed under the strand they belong to.</p>
  </header>

  {answers.length > 0 && (
    <section class="answers" id="answers">
      <h2 class="answers-label">Direct answers</h2>
      <p class="answers-blurb">The question in the title, answered on the page. The essays below keep the history and the economics.</p>
      <ul class="list">
        {answers.map((a) => (
          <li>
            <a href={`/articles/${a.id}/`}>{a.data.serpTitle ?? a.data.title}</a>
            <p>{a.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {strandOrder.map((strand) => {
    const meta = strands[strand];
    const keys = clustersByStrand[strand];
    const count = keys.reduce((n, key) => n + articlesFor(key).length, 0);
    if (count === 0) return null;
    return (
      <section class="strand" id={`strand-${strand}`} style={`--accent: ${meta.colorVar}`}>
        <h2 class="strand-label">{meta.label}</h2>
        <p class="strand-blurb">{meta.caption}</p>
        {keys.map((key) => {
          const cluster = clusters[key];
          const items = articlesFor(key);
          if (items.length === 0) return null;
          return (
            <div class="thread" id={`thread-${key}`}>
              <h3 class="thread-label">{cluster.label}</h3>
              <p class="thread-blurb">{cluster.blurb}</p>
              <ul class="list">
                {items.map((a) => (
                  <li>
                    <a href={`/articles/${a.id}/`}>{a.data.title}</a>
                    <p>{a.data.description}</p>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </section>
    );
  })}

  <style>
    .page-head { margin-top: 3rem; max-width: 46rem; }
    .page-head .eyebrow { margin: 0 0 0.35rem; }
    .page-title { font-size: clamp(2.35rem, 5vw, 3.8rem); margin: 0; }
    .page-sub { color: var(--ink-soft); margin: 0.5rem 0 0; }
    .answers {
      max-width: 46rem;
      margin-top: 2.75rem;
      border-top: 3px solid var(--uv);
      padding-top: 1rem;
      scroll-margin-top: 1.5rem;
    }
    .answers-label { font-size: 1.2rem; margin: 0; color: var(--uv); }
    .answers-blurb { color: var(--ink-soft); font-size: 0.9rem; margin: 0.35rem 0 0.5rem; }
    .strand {
      max-width: 46rem;
      margin-top: 2.75rem;
      border-top: 3px solid var(--accent);
      padding-top: 1rem;
      scroll-margin-top: 1.5rem;
    }
    .strand-label { font-size: 1.35rem; margin: 0; color: var(--accent); }
    .strand-blurb { color: var(--ink-soft); font-size: 0.95rem; margin: 0.35rem 0 0; }
    .thread { margin-top: 1.6rem; scroll-margin-top: 1.5rem; }
    .thread-label { font-size: 1.05rem; margin: 0; color: var(--ink); }
    .thread-blurb { color: var(--ink-soft); font-size: 0.88rem; margin: 0.25rem 0 0.4rem; }
    .list { list-style: none; padding: 0; margin: 0; }
    .list li { border-top: 1px solid var(--line); padding: 1.1rem clamp(0.7rem, 2vw, 1.25rem); background: var(--surface); }
    .list li:first-child { border-top: 0; }
    .list li:focus-within, .list li:hover { background: var(--surface-raised); }
    .list a { font: 600 1.2rem/1.3 var(--font-display); display: inline-block; }
    .list p { margin: 0.3rem 0 0; color: var(--ink-soft); }
  </style>
</Base>
