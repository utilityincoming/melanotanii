---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import pigmentStudy from '../assets/editorial/pigment-study.webp';
import { getCollection } from 'astro:content';
import { clusters, clustersByStrand, clusterStrand, strands, strandOrder } from '../data/clusters';
import { strandPaths } from '../data/strands-pages';
import StrandIndex from '../components/StrandIndex.astro';
import type { Strand } from '../data/clusters';

const all = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Articles for a strand: each cluster's curated lead first, then the rest newest-first.
function articlesForStrand(key: Strand) {
  const leadIds = clustersByStrand[key].map((c) => clusters[c].lead);
  const leads = leadIds
    .map((id) => all.find((a) => a.id === id))
    .filter((a): a is (typeof all)[number] => a !== undefined);
  const seen = new Set(leads.map((a) => a.id));
  const rest = all.filter((a) => clusterStrand(a.data.cluster) === key && !seen.has(a.id));
  return [...leads, ...rest];
}
---
<Base
  title="Melanotan II: the unapproved tanning peptide — Tan Lines"
  description="Melanotan II is an unapproved tanning peptide from 1980s melanoma research. The gray-market vials, and the approved drugs it spawned — none of them a tan."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">History &middot; Analysis &middot; The Record</p>
      <h1>The tanning peptide that never shipped &mdash; and the medicines that did.</h1>
      <p class="lede">
        Search the name and you get a shop or a shrug. This is the file in
        between. Melanotan II was built to prevent melanoma, never approved, and
        sold anyway. Its side effects became approved medicines. None of them is
        a tan. The question the Arizona lab started with is still open: can a
        drug protect human skin from the sun, safely?
      </p>
      <p class="hero-cta">
        <a class="cta-primary" href="/timeline/">Start with the timeline&nbsp;&rarr;</a>
        <a class="cta-secondary" href="/articles/">Browse all articles</a>
      </p>
    </div>
    <figure class="hero-plate">
      <Picture
        src={pigmentStudy}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[360, 540, 768, 1080]}
        sizes="(min-width: 80rem) 34rem, (min-width: 56rem) 43vw, 92vw"
        width={1080}
        height={720}
        quality="mid"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        alt="An illustrated cross-section of upper skin layers with rust-colored pigment granules among the cells."
      />
      <figcaption>Skin and pigment · Interpretive illustration</figcaption>
    </figure>
  </section>

  <section class="section-head" aria-labelledby="home-record">
    <h2 id="home-record">The Record</h2>
    <p>Follow dated developments or explore the clinical reports, diagrams, and trial results behind our skin coverage.</p>
    <p class="hero-cta">
      <a href="/record/">Browse record entries &rarr;</a>
      <a href="/skin-record/">Explore the skin record &rarr;</a>
    </p>
  </section>

  <section class="thesis" aria-label="One origin, three strands">
    <figure class="strand-figure">
      <svg viewBox="0 0 320 174" role="img" aria-labelledby="strand-title strand-desc">
        <title id="strand-title">One origin, three strands</title>
        <desc id="strand-desc">Three lines branch from a shared origin. The upper line ends in an open circle for the unfinished mission, the middle tracks the gray market, and the lower line tracks approved spinoffs.</desc>
        <path class="grid" d="M90 20v134m56-134v134m56-134v134m56-134v134M21 36h278M21 87h278M21 138h278" />
        <path class="strand-path s-mission" d="M30 87C123 87 144 36 286 36" />
        <path class="strand-path s-market" d="M30 87H286" />
        <path class="strand-path s-approval" d="M30 87C123 87 144 138 286 138" />
        <circle class="origin-ring" cx="30" cy="87" r="10" />
        <circle class="origin-dot" cx="30" cy="87" r="4" />
        <circle class="open s-mission" cx="286" cy="36" r="5.5" />
        <circle class="f-market" cx="286" cy="87" r="5.5" />
        <circle class="f-approval" cx="286" cy="138" r="5.5" />
      </svg>
    </figure>
    <ul class="strand-legend">
      {strandOrder.map((key) => (
        <li class={`strand-${key}`}>
          <span class="swatch" aria-hidden="true"></span>
          <a href={strandPaths[key]}>{strands[key].label}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="threads" aria-label="Browse by strand">
    <div class="section-head">
      <h2>Follow a strand</h2>
    </div>
    <div class="clusters">
      {strandOrder.map((key) => {
        const meta = strands[key];
        const items = articlesForStrand(key);
        return (
          <article class="cluster" id={`strand-${key}`} style={`--accent: ${meta.colorVar}`}>
            <h3 class="cluster-label"><a href={strandPaths[key]}>{meta.label}</a></h3>
            <p class="blurb">{meta.caption}</p>
            <StrandIndex
              name={`home-${key}`}
              accent={meta.colorVar}
              items={items.map((article) => ({
                id: article.id,
                href: `/articles/${article.id}/`,
                title: article.data.title,
                description: article.data.description,
                cluster: article.data.cluster,
                date: article.data.pubDate,
              }))}
            />
            <p class="more"><a href={strandPaths[key]}>Strand index</a></p>
          </article>
        );
      })}
    </div>
  </section>

  <aside class="closer" aria-label="The open question">
    <span class="pigment-rule" aria-hidden="true"></span>
    <p class="eyebrow">The strand still waiting</p>
    <h2>The drug it was built for still doesn&rsquo;t exist.</h2>
    <p>
      A general-purpose drug that protects ordinary skin from the sun, and has
      been shown to do it safely, has not arrived. Gray-market vials are still
      standing in for it. This site watches whether the original mission ever
      becomes a medicine.
    </p>
    <p class="closer-cta">
      <a class="cta-primary" href="/timeline/">See the whole timeline&nbsp;&rarr;</a>
      <a class="cta-secondary" href="/regulatory/">Regulatory watch</a>
    </p>
  </aside>

  <style>
    .hero { display: grid; align-items: center; gap: clamp(1.75rem, 4vw, 4rem); padding-block: var(--space-section); }
    .hero-plate {
      margin: 0;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .hero-plate :global(img) { display: block; width: 100%; height: auto; }
    .hero-plate figcaption { padding: 0.7rem 1rem; color: var(--ink-soft); font-size: 0.8rem; }
    .hero .eyebrow { margin: 0; }
    .hero h1 { font-size: clamp(2.55rem, 5.2vw, 4.75rem); line-height: 1.02; margin: 0.65rem 0 1.2rem; text-wrap: pretty; }
    .lede { max-width: 57ch; margin: 0; color: var(--ink-soft); }
    .hero-cta { margin: 1.65rem 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.85rem 1.3rem; }
    @media (min-width: 56rem) { .hero { grid-template-columns: minmax(0, 1.17fr) minmax(0, 1fr); } }
    .cta-primary {
      display: inline-block;
      background: var(--ink);
      color: var(--paper);
      font-weight: 600;
      padding: 0.7rem 1.2rem;
      border-radius: 4px;
      text-decoration: none;
    }
    .cta-primary:hover { background: var(--uv); }
    .cta-secondary { font-weight: 500; color: var(--uv); text-decoration: none; }
    .cta-secondary:hover { text-decoration: underline; text-underline-offset: 3px; }

    .thesis {
      display: grid;
      grid-template-columns: minmax(8rem, 18rem) minmax(0, 1fr);
      align-items: center;
      gap: clamp(0.65rem, 3vw, 2rem);
      padding: clamp(0.7rem, 2vw, 1.25rem);
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      margin-bottom: var(--space-section);
    }
    .strand-figure { margin: 0; }
    .strand-figure svg { width: 100%; height: auto; display: block; }
    .grid { fill: none; stroke: var(--line); stroke-width: 0.75; }
    .strand-path { fill: none; stroke-width: 2.5; stroke-linecap: round; }
    .s-mission { stroke: var(--strand-mission); }
    .s-market { stroke: var(--caution); }
    .s-approval { stroke: var(--approved); }
    .origin-dot { fill: var(--ink); }
    .origin-ring { fill: var(--surface); stroke: var(--ink-soft); stroke-width: 1; }
    .open { fill: var(--surface); stroke-width: 2.5; }
    .f-market { fill: var(--caution); }
    .f-approval { fill: var(--approved); }
    .strand-legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
    .strand-legend li { display: flex; gap: 0.55rem; align-items: baseline; font-size: 0.9rem; }
    .strand-legend a { text-decoration-color: var(--dot); color: var(--ink); }
    .strand-legend a:hover { color: var(--dot); }
    .swatch { flex: none; width: 0.42rem; height: 0.42rem; border-radius: 50%; background: var(--dot); }
    .strand-mission { --dot: var(--strand-mission); }
    .strand-market { --dot: var(--caution); }
    .strand-approval { --dot: var(--approved); }

    /* Threads */
    .section-head { max-width: 46rem; margin: 0 0 1.75rem; }
    .section-head h2 { font-size: clamp(1.9rem, 3.2vw, 2.55rem); margin: 0; }
    .clusters {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
      gap: 1.5rem;
    }
    .cluster {
      background: var(--surface);
      border: 1px solid var(--line);
      border-top: 3px solid var(--accent);
      border-radius: 10px;
      padding: 1.15rem 1.3rem 1.35rem;
      transition: border-color 0.15s ease;
    }
    .cluster:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
    .cluster-label { font-size: 1.55rem; margin: 0; color: var(--ink); }
    .cluster-label a { color: inherit; text-decoration: none; }
    .cluster-label a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .cluster .blurb { margin: 0.35rem 0 1rem; font-size: 0.88rem; color: var(--ink-soft); }
    .cluster ul { list-style: none; margin: 0; padding: 0; }
    .cluster li { padding-block: 0.8rem; border-top: 1px solid var(--line); }
    .cluster li:last-child { margin-bottom: 0; }
    .cluster li p { margin: 0.2rem 0 0; font-size: 0.86rem; color: var(--ink-soft); }
    .cluster a { font-weight: 500; text-decoration: none; }
    .cluster a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .cluster li.lead { border-top-color: var(--accent); }
    .cluster li.lead a { font: 600 1.25rem/1.3 var(--font-display); }
    .cluster li.more { margin-bottom: 0; padding-top: 0.15rem; }
    .cluster li.more a { font-size: 0.9rem; color: var(--uv); }
    .soon { color: var(--ink-soft); font-size: 0.9rem; }

    /* Closer — the mission strand, still open; bookended by the pigment signature */
    .closer {
      position: relative;
      overflow: hidden;
      max-width: 52rem;
      margin: 4rem 0 1rem;
      padding: 2.25rem 1.9rem;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
    }
    .closer .pigment-rule {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: var(--pigment-scale);
    }
    .closer .eyebrow { color: var(--uv); margin: 0.25rem 0 0; }
    .closer h2 { font-size: clamp(1.4rem, 3.5vw, 1.85rem); margin: 0.5rem 0 0.7rem; max-width: 30rem; }
    .closer > p { color: var(--ink-soft); max-width: 44rem; margin: 0; }
    .closer-cta { margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.4rem; }

    @media (max-width: 40rem) {
      .closer { padding: 1.9rem 1.35rem; }
    }
  </style>
</Base>
