---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { clusters, clustersByStrand, strands, strandOrder } from '../data/clusters';
import { strandPaths } from '../data/strands-pages';
import { intents } from '../data/intents';

const articles = await getCollection('articles', ({ data }) => !data.draft);
const doors = strandOrder.map((strand) => {
  const leadId = clusters[clustersByStrand[strand][0]].lead;
  const lead = articles.find((article) => article.id === leadId);
  return { strand, meta: strands[strand], lead };
});

const pageUrl = new URL('/lander/', Astro.site).href;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'The file', item: pageUrl },
  ],
};
---
<Base
  title="The old link opens the file — Tan Lines"
  description="This address used to be a shop. It is a publication now. Start with the Melanotan II record: the mission, the gray market, and the approved spinoffs."
  ogImage="/og/page-lander.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />
  <header class="page-head">
    <p class="eyebrow">An old link</p>
    <h1>The page that used to sell is the front door of the file.</h1>
    <p class="direct-answer">Nothing here is for sale. Melanotan II is not an approved drug. This page is where the record starts.</p>
  </header>

  <section class="doors" aria-label="Three strands">
    {doors.map(({ strand, meta, lead }) => (
      <article style={`--accent: ${meta.colorVar}`}>
        <p class="kicker">{meta.label}</p>
        <h2><a href={strandPaths[strand]}>{meta.caption}</a></h2>
        {lead && (
          <p>
            <a href={`/articles/${lead.id}/`}>{lead.data.title}</a>
          </p>
        )}
      </article>
    ))}
  </section>

  <section class="questions">
    <h2>The questions people bring to this address</h2>
    <ul>
      {intents.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </section>

  <p class="next">
    <a href="/timeline/">The forty-year timeline</a>
    <a href="/history/">The Arizona reading order</a>
    <a href="/record/">The dated file</a>
    <a href="/about/">Why this site exists</a>
  </p>

  <style>
    .page-head { margin-top: 3rem; max-width: 42rem; }
    .eyebrow { margin: 0; }
    h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.05; margin: 0.4rem 0 1rem; }
    .direct-answer {
      margin: 0;
      padding: 0.9rem 1rem;
      border-left: 3px solid var(--ink);
      background: var(--surface);
      font-family: var(--font-display);
      font-size: 1.2rem;
      line-height: 1.4;
    }
    .doors {
      margin-top: 2.5rem;
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
    .doors article {
      border-top: 3px solid var(--accent);
      background: var(--surface);
      padding: 1rem 1.1rem 1.2rem;
    }
    .kicker {
      margin: 0;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .doors h2 { font-size: 1.35rem; margin: 0.35rem 0 0.6rem; line-height: 1.25; }
    .doors h2 a, .doors p a { color: inherit; text-decoration: none; }
    .doors a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .doors p { margin: 0; color: var(--ink-soft); }
    .questions { margin-top: 2.5rem; max-width: 42rem; }
    .questions h2 { font-size: 1.35rem; margin: 0 0 0.8rem; }
    .questions ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; }
    .questions a { font-weight: 600; }
    .next { margin: 2rem 0 1rem; display: flex; flex-wrap: wrap; gap: 0.7rem 1.3rem; }
    .next a { font-weight: 600; }
  </style>
</Base>
