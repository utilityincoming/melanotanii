---
import Base from '../layouts/Base.astro';
import IntentLinks from '../components/IntentLinks.astro';
import { otherIntents } from '../data/intents';

type Strand = 'approved' | 'caution' | 'mission';

interface Catalyst {
  sort: string;      // ISO date for ordering
  when: string;      // display label
  org: string;
  strand: Strand;
  title: string;
  note: string;
  status: 'upcoming' | 'resolved';
  recordId?: string;
}

// Single source of truth for the tracker's freshness. On a restamp, change
// ONLY this ISO date — it drives the visible "Last reviewed" label and the
// JSON-LD dateModified below, so the two can never drift. Restamp when a
// jurisdiction or program actually changes status (next: CUV105 readout Dec 2026,
// CUV107 first patient Feb 2027, dersimelagon decision ~end Feb 2027).
const lastReviewedISO = '2026-11-22';
const datePublishedISO = '2026-08-26';
const lastReviewed = new Date(lastReviewedISO).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});

// Add or update entries here; the page re-sorts and re-files them automatically.
const catalysts: Catalyst[] = [
  {
    sort: '2027-02-01', when: '~ Feb 2027', org: 'FDA · PCAC', strand: 'mission', status: 'upcoming',
    recordId: '2027-02-28-pcac-melanotan',
    title: 'Advisory committee weighs Melanotan II for the compounding list',
    note: 'The FDA’s Pharmacy Compounding Advisory Committee is due to reconsider MT-II — deferred in July 2026 for insufficient safety, efficacy and chemical-characterisation data — for the 503A bulk list, alongside GHK-Cu, Dihexa acetate, Cathelicidin LL-37 and PEG-MGF. The first time its U.S. legitimacy is formally on a calendar — and the single most consequential date here.',
  },
  {
    sort: '2027-02-28', when: '~ end Feb 2027', org: 'FDA · LEO Pharma', strand: 'approved', status: 'upcoming',
    recordId: '2027-02-28-dersimelagon-pdufa',
    title: 'FDA decision on dersimelagon, the first oral MC1R agonist',
    note: 'LEO Pharma said on 18 September 2026 that it had closed the acquisition of worldwide rights from Tanabe and that the FDA had accepted the NDA under priority review, with a PDUFA date by the end of February 2027. If approved, it is still a rare-disease pill, not a tan. The query page is Dersimelagon; the class snapshot is The pipeline right now.',
  },
  {
    sort: '2026-12-01', when: 'Dec 2026', org: 'Clinuvel · CUV105', strand: 'approved', status: 'upcoming',
    recordId: '2026-12-31-cuv105-topline',
    title: 'Phase III vitiligo readout for afamelanotide',
    note: 'Topline from the 210-patient CUV105 trial of SCENESSE in vitiligo — the approved MC1R agonist reaching for its second indication. A positive result widens the beachhead.',
  },
  {
    sort: '2027-02-15', when: 'Feb 2027', org: 'Clinuvel · CUV107', strand: 'approved', status: 'upcoming',
    recordId: '2027-02-28-cuv107-first-patient',
    title: 'Pivotal vitiligo trial (CUV107): first patient now expected in February',
    note: 'On 6 November 2026 the sponsor said protocol validation had taken three extra months. The first patient is now expected in February 2027, not November 2026. The study has not started. The design is unchanged from the April 2026 EMA advice: about 300 patients, Fitzpatrick IV–VI.',
  },
  {
    sort: '2026-08-17', when: '17 Aug 2026', org: 'TGA · Australia', strand: 'caution', status: 'resolved',
    recordId: '2026-08-17-tga-dosing-alert',
    title: 'Lab-tested nasal sprays: 22 mg to 54 mg in bottles labelled 30 mg',
    note: 'Five seized ‘Pure Tans Triple Strength’ bottles from the same NSW seller already fined $101,412 in May. The label was not a specification.',
  },
  {
    sort: '2026-07-13', when: 'Jul 2026', org: 'Health Canada', strand: 'approved', status: 'resolved',
    recordId: '2026-07-09-scenesse-canada',
    title: 'SCENESSE approved for EPP in Canada',
    note: 'Afamelanotide adds another country — the first systemic photoprotectant keeps spreading through the front door.',
  },
  {
    sort: '2026-04-24', when: 'Apr 2026', org: 'EMA · Clinuvel', strand: 'approved', status: 'resolved',
    recordId: '2026-04-24-ema-cuv107',
    title: 'EMA signs off on the pivotal vitiligo trial design',
    note: 'Final scientific advice from the European regulator on the CUV107 pivotal study — the step that turns a vitiligo programme into a filing path. Afamelanotide’s second indication now has a regulator’s fingerprints on its design.',
  },
  {
    sort: '2026-04-15', when: '15 Apr 2026', org: 'FDA · HHS', strand: 'caution', status: 'resolved',
    recordId: '2026-04-15-category-2',
    title: 'Twelve peptides come off the restricted Category 2 list — MT-II among them',
    note: 'Nominators withdrew their petitions and the FDA confirmed the removals on 15 April 2026. Removal is not permission: coming off Category 2 does not place a substance on the 503A bulk list. That question went to the July advisory committee, which deferred MT-II — and to the October interim policy, which excludes it.',
  },
  {
    sort: '2026-07-06', when: '6 Jul 2026', org: 'TGA · Australia', strand: 'caution', status: 'resolved',
    recordId: '2026-07-06-foi-26-3029',
    title: 'Australia’s adverse-event file goes public, case by case',
    note: 'Under freedom-of-information request 26-3029 the TGA released case-level melanotan adverse-event detail — individual reports, causality rated “possible”. The counted pool behind the warnings: 89 reports (2022–2025), two of them melanoma. The attribution gap, in primary documents.',
  },
  {
    sort: '2026-01-20', when: '20 Jan 2026', org: 'Tanabe · MT-7117', strand: 'approved', status: 'resolved',
    recordId: '2026-01-20-tanabe-inspire',
    title: 'Oral MC1R agonist posts positive Phase 3',
    note: 'Dersimelagon — a once-daily pill, not an implant — met its primary endpoint in the 165-patient INSPIRE study in EPP and X-linked protoporphyria. Melanocortin photoprotection escaping the needle is the clearest sign yet the class is advancing; the FDA has since accepted the filing under priority review (see the calendar above).',
  },
  {
    sort: '2025-12-15', when: '15 Dec 2025', org: 'UK · DHSC', strand: 'caution', status: 'resolved',
    recordId: '2025-12-15-dhsc-wran',
    title: 'Parliament told: nasal tanners sit outside medicines law',
    note: 'A written answer of 15 December 2025, to a question tabled on 3 December: injectables are unlicensed medicines; nasal sprays without medical claims are not regarded as medicinal products, so they are not in the MHRA’s remit. The gap, on the record.',
  },
  {
    sort: '2025-09-23', when: '23 Sep 2025', org: 'EMA · EU', strand: 'approved', status: 'resolved',
    recordId: '2025-09-23-scenesse-year-round',
    title: 'EMA approves year-round SCENESSE dosing',
    note: 'Europe widens the approved use of the first systemic photoprotectant.',
  },
  {
    sort: '2023-09-01', when: 'Sep 2023', org: 'FDA', strand: 'caution', status: 'resolved',
    title: 'MT-II placed in compounding Category 2',
    note: 'Designated a bulk substance that “may present significant safety risks” — which is what closed the compounding door in the first place.',
  },
  {
    sort: '2019-10-08', when: '8 Oct 2019', org: 'FDA', strand: 'approved', status: 'resolved',
    recordId: '2019-10-08-fda-scenesse',
    title: 'FDA approves SCENESSE (afamelanotide) for EPP',
    note: 'The first melanocortin agonist approved in the U.S. for a photoprotective use. Proof the approval door opens.',
  },
  {
    sort: '2018-04-10', when: 'Apr 2018', org: 'TGA · Australia', strand: 'caution', status: 'resolved',
    recordId: '2018-04-10-tga-schedule-4',
    title: 'Melanotan II listed in Schedule 4 — prescription-only',
    note: 'The scheduling delegate’s final decision (April 2018, following the November 2017 joint ACCS/ACMS meeting) put melanotan II into Schedule 4 of the Poisons Standard. No product has ever been listed on the ARTG — so lawful supply has never existed. Current editions of the Standard still list it there.',
  },
  {
    sort: '2014-12-22', when: '22 Dec 2014', org: 'European Commission', strand: 'approved', status: 'resolved',
    recordId: '2014-12-22-scenesse-eu',
    title: 'EU approves SCENESSE — the world’s first systemic photoprotectant',
    note: 'Afamelanotide authorised for EPP under exceptional circumstances; the class’s first market approval anywhere.',
  },
];

const upcoming = catalysts
  .filter((c) => c.status === 'upcoming')
  .sort((a, b) => a.sort.localeCompare(b.sort)); // soonest first
const settled = catalysts
  .filter((c) => c.status === 'resolved')
  .sort((a, b) => b.sort.localeCompare(a.sort)); // most recent first

const strandLegend: { key: Strand; label: string; blurb: string }[] = [
  { key: 'approved', label: 'Approved / advancing', blurb: 'A legitimate melanocortin drug moving forward.' },
  { key: 'caution', label: 'Restricted', blurb: 'Melanotan II being walled off further.' },
  { key: 'mission', label: 'Open question', blurb: 'A pending decision worth watching.' },
];

interface Jurisdiction { place: string; status: string; tone: 'danger' | 'caution'; note: string; }
const jurisdictions: Jurisdiction[] = [
  {
    place: 'United States', status: 'Unapproved · not compoundable', tone: 'caution',
    note: 'No approved indication; removed from the restricted Category 2 list in April 2026 but on no compounding list — the October 2026 interim policy excludes it; illegal to market for human use. The FDA has sent warning letters to distributors. The advisory committee returns to it by the end of February 2027.',
  },
  {
    place: 'United Kingdom', status: 'Illegal to sell · legal to possess', tone: 'caution',
    note: 'An unlicensed medicine the MHRA bars from sale — it warned the public in 2008 and later helped suspend over 100 trading websites. Sold instead as a “cosmetic” nasal spray through a gap between the rulebooks that the DHSC confirmed to Parliament in Dec 2025. Selling is illegal; using is not.',
  },
  {
    place: 'Australia', status: 'Schedule 4 · prescription-only', tone: 'caution',
    note: 'Listed in Schedule 4 of the Poisons Standard since the April 2018 scheduling decision — prescription-only, with no product on the ARTG, so no lawful supply channel exists. Suppliers have been fined six figures ($101,412, paid May 2026) and seized bottles have been lab-tested. The toughest enforcement file in the world for MT-II — without a prohibition-grade schedule.',
  },
  {
    place: 'EU & Nordics', status: 'Unapproved · banned as cosmetic', tone: 'caution',
    note: 'No approved indication anywhere in the EU; banned as a cosmetic in Denmark and others. Ireland’s HPRA warns it is not authorised to treat anything and ordered more than 500 online ads removed between 2020 and 2022. Country by country: The enforcement map.',
  },
];

interface ApprovedDrug { drug: string; kind: string; where: string; }
const approved: ApprovedDrug[] = [
  {
    drug: 'Afamelanotide (SCENESSE)', kind: 'MC1R agonist · subcutaneous implant',
    where: 'Approved for EPP in the EU (2014), U.S. (2019), Australia (2020), Israel, and Canada (2026). Now in Phase III for vitiligo, with a readout due Dec 2026.',
  },
  {
    drug: 'Dersimelagon (MT-7117)', kind: 'MC1R agonist · once-daily oral pill',
    where: 'Positive Phase 3 (INSPIRE) in EPP and X-linked protoporphyria (Jan 2026). LEO Pharma closed the acquisition of worldwide rights from Tanabe on 18 September 2026; NDA accepted under priority review, decision expected by the end of Feb 2027. Not approved. Not a tan.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Regulatory watch — Melanotan II & melanocortin photoprotection',
  description:
    'A living tracker of the U.S. and global regulatory status of Melanotan II and the melanocortin agonists (afamelanotide, dersimelagon) developed for photoprotective use — dated catalysts, settled milestones, and jurisdiction-by-jurisdiction status.',
  datePublished: datePublishedISO,
  dateModified: lastReviewedISO,
  isPartOf: { '@id': new URL('/#record', Astro.site).href, name: 'The Record' },
};
---
<Base
  title="Melanotan II regulatory tracker — Tan Lines"
  description="Dated Melanotan II filings at FDA, EMA, TGA and MHRA — catalysts, country status, and the approved melanocortin photoprotective drugs."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <section class="head">
    <p class="eyebrow">The Record</p>
    <h1>On the docket.</h1>
    <p class="direct-answer">Melanotan II is approved nowhere. This page is the dated file of filings, warnings, and trial dates, each one tied to a record entry.</p>
    <p class="lede">
      The question this site is watching, with dates on it: does a legitimate
      photoprotective drug arrive before the gray market sells another vial.
      What is coming, what already happened, and where Melanotan II stands
      in each jurisdiction.
    </p>
    <IntentLinks items={[...otherIntents('regulatory')]} />
    <p class="meta-line">
      <strong>Last reviewed {lastReviewed}.</strong> Analysis, not legal or
      medical advice. Dates are targets and can slip. The short answer by country
      is <a href="/articles/is-melanotan-legal/">Is Melanotan legal?</a>.
      The entries grouped by jurisdiction are <a href="/countries/">by country</a>. For how
      these routes fit together, read <a href="/articles/the-three-doors/">The three doors</a>.
      Major actions carry a dated <a href="/record/">record entry</a> anchored to one primary source.
    </p>
  </section>

  <ul class="legend" aria-label="What the colours mean">
    {strandLegend.map((s) => (
      <li class={`strand-${s.key}`}>
        <span class="swatch" aria-hidden="true"></span>
        <span><strong>{s.label}.</strong> {s.blurb}</span>
      </li>
    ))}
  </ul>

  <section class="block">
    <h2>On the calendar</h2>
    <p class="sub">Dated decisions and readouts still ahead, soonest first.</p>
    <div class="board">
      {upcoming.map((c) => (
        <article class={`catalyst strand-${c.strand}`}>
          <div class="top">
            <span class="when">{c.when}</span>
            <span class="org">{c.org}</span>
          </div>
          <h3>{c.recordId ? <a href={`/record/${c.recordId}/`}>{c.title}</a> : c.title}</h3>
          <p class="note">{c.note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="block settled">
    <h2>Already settled</h2>
    <p class="sub">The milestones that shaped the picture above, most recent first.</p>
    <div class="board">
      {settled.map((c) => (
        <article class={`catalyst strand-${c.strand}`}>
          <div class="top">
            <span class="when">{c.when}</span>
            <span class="org">{c.org}</span>
          </div>
          <h3>{c.recordId ? <a href={`/record/${c.recordId}/`}>{c.title}</a> : c.title}</h3>
          <p class="note">{c.note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="block">
    <h2>Where Melanotan II stands</h2>
    <p class="sub">The unapproved compound, jurisdiction by jurisdiction. The short answer is <a href="/articles/is-melanotan-legal/">Is Melanotan legal?</a></p>
    <div class="grid2">
      {jurisdictions.map((j) => (
        <div class="card j">
          <p class="place">{j.place}</p>
          <span class={`badge ${j.tone}`}>{j.status}</span>
          <p class="note">{j.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="block">
    <h2>The approved side</h2>
    <p class="sub">
      The counterweight to all that restriction: the legitimate melanocortin
      agonists that reached patients the right way — and the pipeline behind them.
    </p>
    <div class="grid2">
      {approved.map((d) => (
        <div class="card drug">
          <p class="place">{d.drug}</p>
          <p class="kind">{d.kind}</p>
          <p class="note">{d.where}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="closer prose">
    <p>
      The through-line: as the legitimate technology keeps advancing —
      approvals, new indications, an oral entrant — Melanotan II keeps getting
      walled off further. Those two trends are the whole story. For how a
      legitimate melanocortin sun drug actually reaches Americans, read
      <a href="/articles/the-three-doors/">The three doors</a>; for the gray
      market it competes with, <a href="/articles/barbie-drug-gray-market/">The Barbie drug</a>;
      for what the warnings actually did, <a href="/articles/what-the-warnings-actually-did/">a decade of enforcement</a>
      and <a href="/articles/the-enforcement-map/">the enforcement map</a>; for the short answer by country, <a href="/articles/is-melanotan-legal/">Is Melanotan legal?</a>;
      for where the legitimate programs stand, <a href="/articles/the-pipeline-right-now/">the pipeline right now</a>;
      for the oral drug itself, <a href="/articles/dersimelagon/">dersimelagon</a>;
      for the approved implant, <a href="/articles/scenesse/">Scenesse is not a tan</a>;
      for the libido spinoff, <a href="/articles/pt-141-vs-melanotan-ii/">PT-141 is not Melanotan II</a>;
      for the full arc, <a href="/timeline/">the timeline</a>.
    </p>
  </section>

  <style>
    .head { padding: 4rem 0 1.5rem; max-width: 48rem; }
    .head h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0.6rem 0 1rem; }
    .direct-answer {
      margin: 0 0 1rem;
      padding: 0.85rem 1rem;
      border-left: 3px solid var(--caution);
      background: var(--surface);
      font-family: var(--font-display);
      font-size: 1.15rem;
      line-height: 1.4;
    }
    .lede { font-size: 1.15rem; color: var(--ink-soft); }
    .meta-line { margin-top: 1.2rem; font-size: 0.82rem; color: var(--ink-soft); line-height: 1.6; }
    .meta-line strong { color: var(--ink); }

    .legend {
      list-style: none;
      margin: 2rem 0 0;
      padding: 1.1rem 1.3rem;
      border: 1px solid var(--line);
      border-radius: 8px;
      display: grid;
      gap: 0.7rem;
      max-width: 48rem;
      background: var(--surface);
    }
    .legend li { display: flex; gap: 0.6rem; align-items: baseline; font-size: 0.9rem; color: var(--ink-soft); }
    .legend strong { color: var(--ink); font-weight: 600; }
    .legend .swatch {
      flex: none; width: 0.8rem; height: 0.8rem;
      border-radius: 50%; margin-top: 0.2rem;
      background: var(--accent, var(--uv));
    }

    .block { margin-top: 3.2rem; max-width: 48rem; }
    .block > h2 { font-size: 1.5rem; margin: 0 0 0.3rem; }
    .block > .sub { color: var(--ink-soft); margin: 0 0 1.4rem; font-size: 0.95rem; }

    .board { display: grid; gap: 1rem; }
    .catalyst {
      border: 1px solid var(--line);
      border-left: 4px solid var(--accent, var(--uv));
      border-radius: 8px;
      background: var(--surface);
      padding: 1.05rem 1.2rem;
    }
    .settled .catalyst { background: transparent; }
    .catalyst .top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 0.8rem; margin-bottom: 0.35rem; }
    .catalyst .when {
      font-family: var(--font-display); font-weight: 600; font-size: 1.05rem;
      color: var(--accent, var(--uv));
    }
    .catalyst .org {
      font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--ink-soft);
    }
    .catalyst h3 { font-size: 1.16rem; margin: 0.1rem 0 0.4rem; }
    .catalyst .note { margin: 0; color: var(--ink); }

    .strand-approved { --accent: var(--approved); }
    .strand-caution { --accent: var(--caution); }
    .strand-mission { --accent: var(--strand-mission); }

    .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); gap: 1rem; }
    .card {
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--surface);
      padding: 1.1rem 1.2rem;
    }
    .card.j { border-left: 4px solid var(--caution); }
    .card.drug { border-left: 4px solid var(--approved); }
    .card .place { font-family: var(--font-display); font-weight: 600; font-size: 1.12rem; margin: 0 0 0.5rem; }
    .card.drug .place { color: var(--approved); }
    .card .note { margin: 0; color: var(--ink-soft); font-size: 0.92rem; }
    .card .kind { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 0.5rem; }
    .badge {
      display: inline-block; font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.05em; text-transform: uppercase;
      padding: 0.22rem 0.55rem; border-radius: 999px; margin-bottom: 0.6rem;
    }
    .badge.caution { color: var(--caution); border: 1px solid var(--caution); }
    .badge.danger { color: var(--paper); background: var(--caution); }

    .closer {
      margin: 3.5rem 0 1rem;
      padding-top: 2rem;
      border-top: 1px solid var(--line);
      color: var(--ink-soft);
      max-width: 48rem;
    }

    @media (max-width: 34rem) {
      .head { padding-top: 2.5rem; }
    }
  </style>
</Base>
