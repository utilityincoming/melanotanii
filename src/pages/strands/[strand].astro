---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { clusters, clustersByStrand, clusterColorVar, strandOrder, strands } from '../../data/clusters';
import type { Strand } from '../../data/clusters';
import { strandPageCopy, strandPaths } from '../../data/strands-pages';

export function getStaticPaths() {
  return strandOrder.map((strand) => ({ params: { strand: strand === 'market' ? 'gray-market' : strand === 'approval' ? 'spinoffs' : 'mission' }, props: { strand } }));
}

const { strand } = Astro.props as { strand: Strand };
const meta = strands[strand];
const copy = strandPageCopy[strand];
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .filter((a) => clustersByStrand[strand].includes(a.data.cluster))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const leadIds = clustersByStrand[strand].map((key) => clusters[key].lead);
const leads = leadIds.map((id) => articles.find((a) => a.id === id)).filter((a) => a !== undefined);
const seen = new Set(leads.map((a) => a.id));
const ordered = [...leads, ...articles.filter((a) => !seen.has(a.id))];

const pageUrl = new URL(strandPaths[strand], Astro.site).href;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: meta.label, item: pageUrl },
  ],
};
---
<Base title={copy.title} description={copy.description} ogImage={`/og/strand-${strand}.png`} ogType="website">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />
  <header class="page-head" style={`--accent: ${meta.colorVar}`}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">&rsaquo;</span>
      <span>{meta.label}</span>
    </nav>
    <p class="eyebrow">{meta.label}</p>
    <h1>{meta.label}</h1>
    <p class="page-sub">{meta.caption}</p>
  </header>
  <div class="cards">
    {ordered.map((article) => (
      <ArticleCard
        href={`/articles/${article.id}/`}
        title={article.data.title}
        description={article.data.description}
        strand={clusters[article.data.cluster].label}
        accent={clusterColorVar(article.data.cluster)}
        date={article.data.pubDate}
      />
    ))}
  </div>
  <p class="elsewhere">
    <a href="/articles/">All articles</a>
    <span aria-hidden="true"> · </span>
    <a href="/timeline/">Timeline</a>
    <span aria-hidden="true"> · </span>
    <a href="/record/">Record entries</a>
  </p>
  <style>
    .page-head { margin-top: 3rem; max-width: 46rem; border-top: 3px solid var(--accent); padding-top: 1rem; }
    .crumbs { display: flex; gap: 0.45rem; font-size: 0.82rem; color: var(--ink-soft); margin: 0 0 0.8rem; }
    .crumbs a { color: var(--ink-soft); text-decoration: none; }
    .eyebrow { margin: 0; color: var(--accent); }
    h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 0.3rem 0; }
    .page-sub { color: var(--ink-soft); margin: 0; }
    .cards { max-width: 46rem; margin-top: 1.5rem; }
    .elsewhere { margin: 2rem 0 1rem; color: var(--ink-soft); }
    .elsewhere a { font-weight: 500; }
  </style>
</Base>
